# ==================================================
# APPLICATION
# ==================================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
API_PREFIX=api/v1

# ==================================================
# DATABASE (PostgreSQL)
# ==================================================
DATABASE_URL=postgresql://monpsy_user:monpsy_password@localhost:5432/monpsy_db?schema=public

# ==================================================
# REDIS
# ==================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0
REDIS_TLS=false

# ==================================================
# JWT
# ==================================================
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRY=7d
JWT_EMAIL_VERIFY_SECRET=your-email-verify-secret-key-change-in-production
JWT_EMAIL_VERIFY_EXPIRY=24h
JWT_RESET_PASSWORD_SECRET=your-reset-password-secret-key-change-in-production
JWT_RESET_PASSWORD_EXPIRY=1h

# ==================================================
# BCRYPT
# ==================================================
BCRYPT_ROUNDS=12

# ==================================================
# ENCRYPTION (AES-256 for sensitive fields)
# ==================================================
ENCRYPTION_KEY=your-32-char-encryption-key-here!!

# ==================================================
# MINIO (S3-compatible object storage)
# ==================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=monpsy
MINIO_PUBLIC_URL=http://localhost:9000

# ==================================================
# EMAIL (SMTP)
# ==================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@monpsy.com
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME=Monpsy
SMTP_FROM_EMAIL=noreply@monpsy.com

# ==================================================
# RATE LIMITING
# ==================================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=900000
AUTH_THROTTLE_LIMIT=10

# ==================================================
# PAYMENTS
# ==================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
KONNECT_API_KEY=your-konnect-api-key
KONNECT_API_URL=https://api.konnect.network
FLOUCI_APP_TOKEN=your-flouci-app-token
FLOUCI_APP_SECRET=your-flouci-app-secret
PAYMEE_API_KEY=your-paymee-api-key
PAYMEE_API_URL=https://app.paymee.tn/api/v2

# ==================================================
# 2FA (TOTP)
# ==================================================
TWO_FACTOR_APP_NAME=Monpsy

# ==================================================
# CORS
# ==================================================
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# ==================================================
# BULL / QUEUE
# ==================================================
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=redis_password

# ==================================================
# PUSH NOTIFICATIONS (Firebase FCM)
# ==================================================
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=your-firebase-client-email
FCM_PRIVATE_KEY=your-firebase-private-key

# ==================================================
# SMS (Twilio)
# ==================================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
