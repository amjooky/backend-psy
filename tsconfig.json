{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "incremental": false,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@common/*": ["./common/*"],
      "@modules/*": ["./modules/*"],
      "@config/*": ["./config/*"],
      "@database/*": ["./database/*"],
      "@jobs/*": ["./jobs/*"],
      "@events/*": ["./events/*"]
    }
  },
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts", "JitsiConsultationRoom.tsx", "prisma"]
}
